# ==============================================================
# Shopper Trilha — variáveis de ambiente (Fase 1)
# Copie para .env.local e preencha. NUNCA commitar .env.local.
# Nenhuma dessas variáveis deve ter o prefixo NEXT_PUBLIC_ —
# todas são usadas apenas em código server-side.
# ==============================================================

# --- Supabase / Postgres ---
# URL do projeto Supabase (painel > Project Settings > API)
SUPABASE_URL=

# Service role key (painel > Project Settings > API > service_role)
# Tem privilégio total no banco — nunca expor ao cliente, nunca logar.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string direta ao Postgres, usada pelas migrations
# (painel > Project Settings > Database > Connection string > URI)
DATABASE_URL=

# --- Sessão / autenticação própria (Fase 2) ---
# Segredo usado para assinar o cookie de sessão httpOnly.
# Gerar com: openssl rand -base64 32
SESSION_SECRET=

# --- Google Drive (Fase 4 — ainda não usado na Fase 1) ---
# Preenchido quando a integração com o Drive for implementada.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
